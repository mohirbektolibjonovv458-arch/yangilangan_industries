# Ushbu faylni .env nomi bilan nusxalab, qiymatlarni to'ldiring:
#   cp .env.example .env

# Django
SECRET_KEY=django-insecure-CHANGE-THIS-TO-A-RANDOM-SECRET-KEY
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Lokal ishga tushirish uchun PostgreSQL talab qilinmaydi:
DB_ENGINE=sqlite

# PostgreSQL ishlatmoqchi bo'lsangiz, yuqoridagini postgresql ga o'zgartiring
# va quyidagi qiymatlarni to'ldiring:
# DB_ENGINE=postgresql
DB_NAME=sponge_factory_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Railway kabi hostinglarda avtomatik beriladi (bo'lsa, yuqoridagi DB_* larni chetlab o'tadi)
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# Telegram bildirishnoma (buyurtma tushganda sizga xabar yuborish uchun)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
